{
	"name": "Advent of Code",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Debian's system Python is externally managed, so install into the user site.
	"postCreateCommand": "pip3 install --user --break-system-packages pylint -r requirements.txt",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"ms-python.black-formatter",
				"rust-lang.rust-analyzer",
				"ms-vscode.cmake-tools"
			],
			"settings": {
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter"
				},
				"pylint.args": ["--rcfile=${workspaceFolder}/.pylintrc"]
			}
		}
	}
}
